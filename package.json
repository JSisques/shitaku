{
  "name": "@jsisques/shitaku",
  "version": "0.2.0",
  "description": "Portable, configurable AI agent setup (skills, MCPs, etc.) installable via npx.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSisques/shitaku"
  },
  "bin": {
    "shitaku": "./dist/main.js"
  },
  "files": [
    "dist",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node node_modules/typescript-native/bin/tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/check-dist-aliases.mjs",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:pack",
    "prepare": "husky || true",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed origin/main --passWithNoTests",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "docs:catalog": "node scripts/generate-catalog-table.mjs",
    "docs:catalog:check": "node scripts/generate-catalog-table.mjs --check",
    "docs:website-catalog": "node scripts/generate-website-catalog.mjs",
    "docs:website-catalog:check": "node scripts/generate-website-catalog.mjs --check"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "semantic-release": "25.0.9",
    "tsc-alias": "1.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{ts,mjs,js})": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
